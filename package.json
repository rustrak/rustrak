{
  "name": "rustrak",
  "private": true,
  "scripts": {
    "ci": "pnpm run ci:web && pnpm run ci:rust",
    "ci:web": "turbo run build test lint format:check check-types doctor generate:check --filter=!@rustrak/server --filter=!@rustrak/benchmarks",
    "ci:rust": "turbo run format:check lint test openapi:check --filter=@rustrak/server --filter=@rustrak/benchmarks",
    "build": "turbo run build",
    "build:dev": "turbo run build:dev",
    "build:docs": "turbo run build --filter=docs",
    "dev": "turbo run dev",
    "dev:docs": "turbo run dev --filter=docs",
    "test": "turbo run test",
    "lint": "turbo run lint",
    "format": "turbo run format",
    "format:check": "turbo run format:check",
    "check-types": "turbo run check-types",
    "doctor": "react-doctor",
    "clean": "turbo run clean",
    "changeset": "changeset",
    "version-packages": "changeset version && bash scripts/sync-version.sh"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.7",
    "@changesets/changelog-github": "1.0.1",
    "@changesets/cli": "3.0.3",
    "react-doctor": "0.9.23",
    "turbo": "2.11.11",
    "typescript": "6.0.3"
  },
  "packageManager": "pnpm@12.18.0",
  "engines": {
    "node": ">=22.18"
  }
}
