{
  "$schema": "https://v2-9-14.turborepo.dev/schema.json",
  "ui": "tui",
  "//": "The Rust crates are turbo packages so that `pnpm build`, `pnpm test` and `pnpm run ci` reach them, but their tasks are never cached by turbo. Cargo is the cache: target/ holds per-crate fingerprints that make an unchanged rebuild a no-op, and it is what Swatinem/rust-cache restores in CI. Turbo could only store the final binary, keyed on the crate's own files, and would then skip `cargo test` on a toolchain upgrade it cannot see. Turbo's experimental Cargo support draws the same line: target/ is not an output. The server's builds still wait for the dashboard, because scripts/bundle-dashboard.sh copies its dist/ into apps/server/static first.",
  "globalDependencies": ["biome.json", "scripts/bundle-dashboard.sh"],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", ".env*"],
      "outputs": [".next/**", "!.next/cache/**", "!.next/dev/**", "out/**", "dist/**"]
    },
    "build:dev": {
      "dependsOn": ["^build:dev"],
      "inputs": ["$TURBO_DEFAULT$", ".env*"]
    },
    "lint": {
      "dependsOn": ["^lint"]
    },
    "//#doctor": {
      "inputs": [
        "doctor.config.json",
        "apps/*/src/**",
        "apps/*/package.json",
        "packages/*/src/**",
        "packages/*/package.json",
        "pnpm-lock.yaml"
      ]
    },
    "check-types": {
      "dependsOn": ["^check-types", "^build"]
    },
    "test": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", ".env*"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "@rustrak/dashboard#dev": {
      "dependsOn": ["@rustrak/client#build"],
      "cache": false,
      "persistent": true
    },
    "format": {
      "cache": false
    },
    "format:check": {
      "inputs": ["$TURBO_DEFAULT$"]
    },
    "clean": {
      "cache": false
    },

    "@rustrak/server#build": {
      "dependsOn": ["@rustrak/dashboard#build"],
      "cache": false
    },
    "@rustrak/server#build:dev": {
      "dependsOn": ["@rustrak/dashboard#build"],
      "cache": false
    },
    "@rustrak/server#test": {
      "cache": false
    },
    "@rustrak/server#lint": {
      "cache": false
    },
    "@rustrak/server#format:check": {
      "cache": false
    },
    "@rustrak/benchmarks#build": {
      "cache": false
    },
    "@rustrak/benchmarks#build:dev": {
      "cache": false
    },

    "bench": {
      "dependsOn": ["build"],
      "cache": false,
      "inputs": ["$TURBO_DEFAULT$", "scenarios/**"]
    },
    "bench:baseline": {
      "dependsOn": ["build"],
      "cache": false
    },
    "bench:burst": {
      "dependsOn": ["build"],
      "cache": false
    },
    "bench:sustained": {
      "dependsOn": ["build"],
      "cache": false
    },
    "bench:stress": {
      "dependsOn": ["build"],
      "cache": false
    }
  }
}
