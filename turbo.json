{
  "$schema": "https://v2-9-14.turborepo.dev/schema.json",
  "ui": "tui",
  "//": "The two Rust crates are turbo packages so that `pnpm build`, `pnpm test` and `pnpm run ci` reach them, but turbo never caches a cargo task: target/ carries per-crate fingerprints turbo cannot see, and a restored `target/` from a different toolchain is worse than none. Cargo tasks also do not run in parallel however the graph looks; they queue on the target directory lock. CI (.github/workflows/ci.yml) runs the same package scripts with pnpm, one runner per concern, for that reason; `ci:rust` here is the local equivalent.",
  "globalDependencies": ["biome.json", "scripts/bundle-dashboard.sh"],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", ".env*"],
      "outputs": [".next/**", "!.next/cache/**", "!.next/dev/**", "out/**", "dist/**"]
    },
    "docs#build": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", ".env*", "$TURBO_ROOT$/apps/server/openapi.json"],
      "outputs": [".next/**", "!.next/cache/**", "!.next/dev/**", "out/**"]
    },
    "build:dev": {
      "dependsOn": ["^build:dev"],
      "inputs": ["$TURBO_DEFAULT$", ".env*"]
    },
    "lint": {},
    "//#doctor": {
      "inputs": [
        "doctor.config.json",
        "apps/*/src/**",
        "apps/*/package.json",
        "packages/*/src/**",
        "packages/*/package.json",
        "pnpm-lock.yaml"
      ]
    },
    "check-types": {
      "dependsOn": ["^check-types", "^build"]
    },
    "test": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", ".env*"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "docs#dev": {
      "dependsOn": ["@rustrak/ui#build"],
      "cache": false,
      "persistent": true
    },
    "@rustrak/dashboard#dev": {
      "dependsOn": ["@rustrak/client#build", "@rustrak/ui#build"],
      "cache": false,
      "persistent": true
    },
    "format": {
      "cache": false
    },
    "format:check": {
      "inputs": ["$TURBO_DEFAULT$"]
    },
    "clean": {
      "cache": false
    },

    "@rustrak/server#build": {
      "dependsOn": ["@rustrak/dashboard#build"],
      "cache": false
    },
    "@rustrak/server#build:dev": {
      "dependsOn": ["@rustrak/dashboard#build"],
      "cache": false
    },
    "@rustrak/server#test": {
      "cache": false
    },
    "@rustrak/client#generate:check": {
      "cache": false
    },
    "@rustrak/server#openapi:check": {
      "dependsOn": ["@rustrak/server#test"],
      "cache": false
    },
    "@rustrak/server#lint": {
      "cache": false
    },
    "@rustrak/server#format:check": {
      "cache": false
    },
    "@rustrak/benchmarks#build": {
      "cache": false
    },
    "@rustrak/benchmarks#build:dev": {
      "cache": false
    },
    "@rustrak/benchmarks#lint": {
      "cache": false
    },
    "@rustrak/benchmarks#format:check": {
      "cache": false
    },
    "@rustrak/benchmarks#test": {
      "cache": false
    }
  }
}
