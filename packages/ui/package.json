{
  "name": "@rustrak/ui",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "sideEffects": [
    "*.css"
  ],
  "files": [
    "dist",
    "src"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./styles.css": "./src/styles/index.css",
    "./tokens.css": "./src/styles/tokens.css",
    "./base.css": "./src/styles/base.css",
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "check-types": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "storybook": "storybook dev -p 6008 --no-open",
    "build-storybook": "storybook build",
    "lint": "biome check src",
    "format": "biome format --write src",
    "format:check": "biome format src",
    "clean": "rm -rf dist storybook-static .turbo"
  },
  "dependencies": {
    "@base-ui/react": "1.9.0",
    "@hugeicons/core-free-icons": "4.4.0",
    "@hugeicons/react": "1.1.10",
    "@tanstack/react-table": "9.3.1",
    "clsx": "2.1.1",
    "recharts": "3.10.1",
    "tailwind-merge": "3.7.0",
    "tailwind-variants": "4.0.2"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@storybook/addon-a11y": "10.6.7",
    "@storybook/addon-docs": "10.6.7",
    "@storybook/addon-themes": "10.6.7",
    "@storybook/addon-vitest": "10.6.7",
    "@storybook/react-vite": "10.6.7",
    "@tailwindcss/vite": "4.3.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitest/browser": "5.1.0",
    "@vitest/browser-playwright": "5.1.0",
    "playwright": "1.65.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "storybook": "10.6.7",
    "tailwindcss": "4.3.5",
    "tsdown": "0.23.7",
    "typescript": "6.0.3",
    "vite": "8.3.8",
    "vitest": "5.1.0"
  }
}
