{
  "$schema": "https://react.doctor/schema/config.json",
  "ignore": {
    "overrides": [
      {
        "files": [
          "src/docs/blocks/**"
        ],
        "rules": [
          "deslop/unused-file"
        ]
      },
      {
        "files": [
          "src/docs/blocks/page.tsx"
        ],
        "rules": [
          "react-doctor/heading-has-content"
        ]
      },
      {
        "files": [
          ".storybook/main.ts"
        ],
        "rules": [
          "react-doctor/unsafe-json-in-html"
        ]
      }
    ]
  }
}
