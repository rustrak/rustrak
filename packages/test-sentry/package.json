{
  "name": "@rustrak/test-sentry",
  "version": "0.1.0",
  "private": true,
  "description": "Test utility for sending Sentry events to Rustrak server",
  "type": "module",
  "scripts": {
    "start": "tsx src/cli.ts",
    "check-types": "tsc --noEmit",
    "demo:build": "node demo/build.mjs",
    "demo:run": "node demo/dist/app.js",
    "demo:sessions": "tsx demo/src/sessions.ts",
    "demo:logs": "tsx demo/src/logs.ts",
    "demo:crons": "tsx demo/src/crons.ts",
    "demo:ai-agent": "tsx --import demo/src/ai-agent-instrument.ts demo/src/ai-agent.ts",
    "lint": "biome check .",
    "format:check": "biome format ."
  },
  "dependencies": {
    "@sentry/node": "11.12.0"
  },
  "devDependencies": {
    "@sentry/esbuild-plugin": "11.12.0",
    "@types/node": "26.6.6",
    "ai": "7.0.173",
    "esbuild": "0.28.2",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "zod": "4.6.7"
  }
}
