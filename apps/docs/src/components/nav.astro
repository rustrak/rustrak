---
import { CloseIcon, MenuIcon, Wordmark } from '@rustrak/ui';
import { CONTAINER, GITHUB, LINKS, START } from '../site';
import { LinkButton } from './link-button';

const GITHUB_MARK =
  'M12 .5C5.73.5.5 5.74.5 12.04c0 5.1 3.29 9.42 7.86 10.95.58.1.79-.25.79-.56v-2c-3.2.7-3.87-1.37-3.87-1.37-.52-1.33-1.28-1.69-1.28-1.69-1.04-.72.08-.7.08-.7 1.15.08 1.76 1.19 1.76 1.19 1.03 1.76 2.69 1.25 3.35.96.1-.75.4-1.25.73-1.54-2.55-.29-5.24-1.28-5.24-5.69 0-1.26.45-2.29 1.18-3.1-.12-.29-.51-1.46.11-3.05 0 0 .97-.31 3.17 1.18a11 11 0 0 1 5.77 0c2.2-1.49 3.17-1.18 3.17-1.18.63 1.59.23 2.76.11 3.05.74.81 1.18 1.84 1.18 3.1 0 4.42-2.7 5.39-5.26 5.68.41.36.78 1.06.78 2.14v3.17c0 .31.21.67.8.56A11.5 11.5 0 0 0 23.5 12.04C23.5 5.74 18.27.5 12 .5Z';

/** The section a path belongs to: `/blog/x` is under Blog. */
const path = Astro.url.pathname;
const isCurrent = (href: string) =>
  path === href || path.startsWith(`${href}/`);
---

<header
  id="site-header"
  class="enter group/header fixed inset-x-0 top-0 z-50 border-b border-transparent transition-[background-color,border-color] duration-slow ease-standard data-scrolled:border-border-subtle data-scrolled:bg-canvas/80 data-scrolled:backdrop-blur-xl data-open:border-border-subtle data-open:bg-canvas data-open:backdrop-blur-none"
  style="--y:-16px;--duration:1s;--delay:0.1s"
>
  <nav class:list={[CONTAINER, 'flex h-16 items-center gap-8']}>
    <a href="/" aria-label="Rustrak home">
      <Wordmark className="h-5 w-auto text-fg" />
    </a>
    <ul class="hidden items-center gap-6 md:flex">
      {
        LINKS.map((link) => (
          <li>
            <a
              href={link.href}
              aria-current={isCurrent(link.href) ? 'page' : undefined}
              class="text-control text-fg-subtle transition-colors hover:text-fg aria-[current=page]:text-fg"
            >
              {link.label}
            </a>
          </li>
        ))
      }
    </ul>
    <div class="ms-auto flex items-center gap-2">
      <LinkButton href={GITHUB} variant="ghost" size="sm" className="max-sm:hidden">
        <svg viewBox="0 0 24 24" class="size-4" fill="currentColor" aria-hidden="true">
          <path d={GITHUB_MARK} />
        </svg>
        GitHub
      </LinkButton>
      <!-- The open sheet carries its own, full-width. -->
      <LinkButton href={START} variant="primary" size="sm" className="group-data-open/header:max-md:hidden">
        Get started
      </LinkButton>
      <button
        id="site-menu-toggle"
        type="button"
        aria-label="Open menu"
        aria-expanded="false"
        aria-controls="site-menu"
        class="-me-2 grid size-10 place-items-center rounded-md text-fg-subtle transition-colors hover:text-fg md:hidden"
      >
        <span class="group-data-open/header:hidden"><MenuIcon size="xl" /></span>
        <span class="hidden group-data-open/header:inline"><CloseIcon size="xl" /></span>
      </button>
    </div>
  </nav>

  <!-- Below md the links open as a full-height sheet under the bar. -->
  <div
    id="site-menu"
    class="sheet absolute inset-x-0 top-full hidden h-[calc(100dvh-4rem)] flex-col overflow-y-auto overscroll-contain bg-canvas group-data-open/header:flex md:hidden!"
  >
    <ul class:list={[CONTAINER, 'flex flex-col pt-6']}>
      {
        LINKS.map((link, i) => (
          <li class="sheet-item" style={`--delay:${0.04 + i * 0.04}s`}>
            <a
              href={link.href}
              aria-current={isCurrent(link.href) ? 'page' : undefined}
              class="flex items-center gap-3 py-3 text-[1.75rem] text-fg-subtle tracking-tight transition-colors hover:text-fg aria-[current=page]:text-fg"
            >
              {link.label}
            </a>
          </li>
        ))
      }
    </ul>
    <div class:list={[CONTAINER, 'sheet-item mt-auto flex flex-col gap-3 pb-10']} style="--delay:0.28s">
      <LinkButton href={GITHUB} variant="ghost" size="lg">
        <svg viewBox="0 0 24 24" class="size-4" fill="currentColor" aria-hidden="true">
          <path d={GITHUB_MARK} />
        </svg>
        Star on GitHub
      </LinkButton>
      <LinkButton href={START} variant="primary" size="lg">Get started</LinkButton>
    </div>
  </div>
</header>

<style>
  /* Fades in and, with `allow-discrete`, back out before `display: none`
     takes it away. */
  .sheet {
    opacity: 0;
    transition:
      opacity 0.2s ease-out,
      display 0.2s allow-discrete;
  }
  :global([data-open]) .sheet {
    opacity: 1;
    @starting-style {
      opacity: 0;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .sheet {
      transition: none;
    }
  }
  .sheet-item {
    animation: reveal 0.45s var(--ease-landing) var(--delay) both;
    --y: 12px;
  }
</style>

<script>
  const header = document.getElementById('site-header')!;
  const toggle = document.getElementById('site-menu-toggle')!;
  const wide = window.matchMedia('(min-width: 48rem)');

  // The bar takes a surface once the page moves under it.
  const onScroll = () => header.toggleAttribute('data-scrolled', scrollY > 8);
  onScroll();
  addEventListener('scroll', onScroll, { passive: true });

  // While the sheet is open the page under it stays put and out of reach of
  // the keyboard (`inert`), Escape closes it, and so does the window growing
  // past `md`, where the sheet and its toggle are hidden.
  const setOpen = (open: boolean) => {
    header.toggleAttribute('data-open', open);
    toggle.setAttribute('aria-expanded', String(open));
    toggle.setAttribute('aria-label', open ? 'Close menu' : 'Open menu');
    document.documentElement.style.overflow = open ? 'hidden' : '';
    for (const el of header.parentElement!.children) {
      if (el !== header && el instanceof HTMLElement) el.inert = open;
    }
  };
  toggle.addEventListener('click', () =>
    setOpen(!header.hasAttribute('data-open')),
  );
  addEventListener('keydown', (e) => e.key === 'Escape' && setOpen(false));
  wide.addEventListener('change', () => wide.matches && setOpen(false));
</script>
