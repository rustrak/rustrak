---
import Reveal from '../reveal.astro';

/** A chart or table in a panel, with an optional caption under it. */
interface Props {
  class?: string;
}
const { class: className } = Astro.props;
---

<Reveal
  y={40}
  class:list={[
    'min-w-0 rounded-3xl border border-border-subtle bg-panel p-5 sm:p-8',
    className,
  ]}
>
  <figure class="flex flex-col gap-6">
    <slot />
    {
      Astro.slots.has('caption') && (
        <figcaption class="max-w-2xl text-pretty text-fg-meta text-meta">
          <slot name="caption" />
        </figcaption>
      )
    }
  </figure>
</Reveal>
