---
import { ChevronDownIcon, MenuIcon, SearchIcon, Wordmark } from '@rustrak/ui';
import { getReleases } from '../../changelog';
import { TABS } from '../../docs-nav';
import { GITHUB } from '../../site';

/**
 * The documentation's own bar: the wordmark, the three tabs that scope the
 * sidebar (the one you are in on a surface, like the sidebar's current
 * page), the reference menu, search, the version these docs describe, and
 * GitHub. Fixed, with
 * the page passing under it.
 */
interface Props {
  tab: string;
  /** Whether the page has the navigation drawer the menu button opens. */
  menu?: boolean;
}
const { tab, menu = true } = Astro.props;
const latest = (await getReleases())[0];

const REFERENCE = [
  {
    title: 'API',
    links: [
      {
        title: 'API Reference',
        detail: 'Every endpoint, with requests you can try',
        href: '/api-reference',
      },
      {
        title: 'OpenAPI spec',
        detail: 'The same, as openapi.json',
        href: '/openapi.json',
      },
    ],
  },
  {
    title: 'For AI assistants',
    links: [
      {
        title: 'Docs for AI assistants',
        detail: 'What to give an assistant, and how',
        href: '/reference/llms',
      },
      {
        title: 'llms.txt',
        detail: 'Every page, one line each',
        href: '/llms.txt',
      },
      {
        title: 'llms-full.txt',
        detail: 'The whole documentation in one file',
        href: '/llms-full.txt',
      },
    ],
  },
];
---

<header
  class="docs-header fixed inset-x-0 top-0 z-40 border-border-subtle border-b bg-canvas/85 backdrop-blur-xl"
>
  <div class="mx-auto flex h-14 w-full max-w-[90rem] items-center gap-6 px-4 sm:px-6">
    {menu && (
    <button
      type="button"
      data-open-nav
      aria-label="Open navigation"
      class="-ms-2 grid size-9 place-items-center rounded-md text-fg-subtle transition-colors hover:text-fg lg:hidden"
    >
      <MenuIcon size="lg" />
    </button>
    )}
    <a href="/" aria-label="Rustrak home" class="shrink-0">
      <Wordmark still className="h-[18px] w-auto text-fg" />
    </a>

    <nav aria-label="Documentation sections" class="hidden lg:block">
      <ul class="flex items-center gap-1">
        {
          TABS.map((t) => (
            <li>
              <a
                href={t.href}
                aria-current={t.id === tab ? 'true' : undefined}
                class="flex h-8 items-center gap-2 rounded-lg px-3 text-control text-fg-subtle transition-colors hover:bg-surface/60 hover:text-fg aria-[current]:bg-surface aria-[current]:text-fg"
              >
                {t.title}
                {t.badge && <span class="tab-badge">{t.badge}</span>}
              </a>
            </li>
          ))
        }
        <li class="relative">
          <!-- The reference material: the API reference and the files for
               AI assistants. -->
          <button
            type="button"
            popovertarget="docs-reference"
            class="flex h-8 items-center gap-2 rounded-lg px-3 text-control text-fg-subtle transition-colors hover:bg-surface/60 hover:text-fg"
            style="anchor-name: --docs-reference"
          >
            Reference
            <ChevronDownIcon size="sm" />
          </button>
          <div
            id="docs-reference"
            popover
            data-menu
            class="m-0 w-72 rounded-xl border border-border-subtle bg-surface-floating p-1.5 text-fg shadow-overlay"
            style="position-anchor: --docs-reference; inset: auto; top: anchor(bottom); left: anchor(left); margin-top: 8px"
          >
            {
              REFERENCE.map((group) => (
                <div class="py-1 [&+&]:border-border-subtle [&+&]:border-t">
                  <p class="px-2.5 pt-1.5 pb-1 font-mono text-[11px] text-fg-meta uppercase tracking-wider">
                    {group.title}
                  </p>
                  {group.links.map((link) => (
                    <a
                      href={link.href}
                      class="flex flex-col gap-0.5 rounded-md px-2.5 py-2 transition-colors hover:bg-surface-hover"
                    >
                      <span class="text-control text-fg">{link.title}</span>
                      <span class="text-fg-meta text-meta">{link.detail}</span>
                    </a>
                  ))}
                </div>
              ))
            }
          </div>
        </li>
      </ul>
    </nav>

    <div class="ms-auto flex items-center gap-2">
      <button
        type="button"
        data-open-search
        class="flex h-8 items-center gap-2 rounded-lg border border-border-subtle bg-surface/60 ps-2.5 pe-1.5 text-fg-meta text-control transition-colors hover:border-border hover:text-fg-subtle sm:w-60"
      >
        <SearchIcon size="sm" />
        <span class="hidden sm:inline">Search docs</span>
        <kbd
          class="ms-auto hidden rounded border border-border-subtle px-1.5 font-mono text-[11px] text-fg-meta sm:inline"
        >
          ⌘K
        </kbd>
      </button>
      {
        latest && (
          <a
            href="/changelog"
            title="These docs describe the latest release"
            class="hidden h-8 items-center rounded-lg px-2.5 font-mono text-fg-subtle text-mono-sm transition-colors hover:text-fg md:flex"
          >
            {latest.version}
          </a>
        )
      }
      <a
        href={GITHUB}
        aria-label="Rustrak on GitHub"
        class="grid size-8 place-items-center rounded-lg text-fg-subtle transition-colors hover:text-fg"
      >
        <svg viewBox="0 0 24 24" class="size-4" fill="currentColor" aria-hidden="true">
          <path
            d="M12 .5C5.73.5.5 5.74.5 12.04c0 5.1 3.29 9.42 7.86 10.95.58.1.79-.25.79-.56v-2c-3.2.7-3.87-1.37-3.87-1.37-.52-1.33-1.28-1.69-1.28-1.69-1.04-.72.08-.7.08-.7 1.15.08 1.76 1.19 1.76 1.19 1.03 1.76 2.69 1.25 3.35.96.1-.75.4-1.25.73-1.54-2.55-.29-5.24-1.28-5.24-5.69 0-1.26.45-2.29 1.18-3.1-.12-.29-.51-1.46.11-3.05 0 0 .97-.31 3.17 1.18a11 11 0 0 1 5.77 0c2.2-1.49 3.17-1.18 3.17-1.18.63 1.59.23 2.76.11 3.05.74.81 1.18 1.84 1.18 3.1 0 4.42-2.7 5.39-5.26 5.68.41.36.78 1.06.78 2.14v3.17c0 .31.21.67.8.56A11.5 11.5 0 0 0 23.5 12.04C23.5 5.74 18.27.5 12 .5Z"
          ></path>
        </svg>
      </a>
    </div>
  </div>
</header>
