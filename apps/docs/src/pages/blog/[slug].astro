---
import { render } from 'astro:content';
import { Avatar } from '@rustrak/ui';
import { formatDate, getPosts, isoDate, readingTime } from '../../blog';
import Backdrop from '../../components/backdrop.astro';
import ReadingRail from '../../components/blog/reading-rail.astro';
import Closing from '../../components/closing.astro';
import Reveal from '../../components/reveal.astro';
import Words from '../../components/words.astro';
import Page from '../../layouts/page.astro';
import { jsonLd } from '../../seo';
import { CONTAINER } from '../../site';
import '../../styles/prose.css';

export async function getStaticPaths() {
  const posts = await getPosts();
  // Newest first, so the next one in the list is the older post.
  return posts.map((post, i) => ({
    params: { slug: post.id },
    props: { post, newer: posts[i - 1], older: posts[i + 1] },
  }));
}

const { post, newer, older } = Astro.props;
const { title, description, date, author, tags } = post.data;
const { Content, headings } = await render(post);
const SITE = Astro.site?.origin;

/** The element the reading progress is measured against. */
const BODY_ID = 'post-body';

const neighbours = [
  newer && { post: newer, label: 'Newer' },
  older && { post: older, label: 'Older' },
].filter(Boolean) as { post: typeof post; label: string }[];
---

<!--
  A post: the opening on the landing's photograph, then one centred column
  in the landing's type with the contents pinned to its right from `xl` up
  (below that only the reading-progress hairline survives, which a phone
  wants as much as a desktop), the posts either side, and the way in.
-->
<Page
  title={`${title} | Rustrak Blog`}
  description={description}
  article={{ published: date, author, tags }}
  markdown={`/blog/${post.id}.md`}
>
  <script
    slot="head"
    type="application/ld+json"
    set:html={jsonLd({
      '@context': 'https://schema.org',
      '@type': 'BlogPosting',
      headline: title,
      description,
      datePublished: isoDate(date),
      author: { '@type': 'Person', name: author },
      publisher: { '@id': `${SITE}/#organization` },
      mainEntityOfPage: `${SITE}/blog/${post.id}`,
    })}
  />

  <!-- The opening, set on the landing's photograph: where it sits, the
       title, the standfirst, and who wrote it and when. -->
  <div class:list={[CONTAINER, 'pt-28 sm:pt-32']}>
    <Backdrop dim onLoad>
      <header class="flex flex-col gap-6 px-6 py-14 sm:px-12 sm:py-20">
        <div
          class="flex flex-wrap items-center justify-between gap-x-6 gap-y-2 font-mono text-mono uppercase tracking-wider"
        >
          <a href="/blog" class="text-fg-brand transition-colors hover:text-fg">
            ← Blog
          </a>
          {
            tags.length > 0 && (
              <span class="text-fg-secondary text-mono-sm">{tags.join(' · ')}</span>
            )
          }
        </div>
        <Words
          onLoad
          as="h1"
          text={title}
          delay={0.1}
          class="max-w-[24ch] text-balance text-fg text-headline"
        />
        <Reveal onLoad delay={0.35}>
          <p class="max-w-[58ch] text-pretty text-fg-secondary text-lead">
            {description}
          </p>
        </Reveal>
        <Reveal onLoad
          delay={0.45}
          class="mt-4 flex flex-wrap items-center gap-x-3 gap-y-2 text-fg-secondary text-meta"
        >
          <Avatar name={author} size="md" />
          <span class="text-fg">{author}</span>
          <span aria-hidden="true">·</span>
          <time datetime={isoDate(date)}>{formatDate(date)}</time>
          <span aria-hidden="true">·</span>
          <span>{readingTime(post.body)} read</span>
        </Reveal>
      </header>
    </Backdrop>
  </div>

  <div
    class="mx-auto grid w-full max-w-7xl px-6 pt-16 pb-20 xl:grid-cols-[minmax(0,1fr)_44rem_minmax(0,1fr)] xl:gap-x-12"
  >
    <div class="min-w-0 xl:col-start-2">
      <article
      id={BODY_ID}
      class="prose"
      data-pagefind-body
      data-pagefind-meta={`title:${title}`}
    >
        <Content />
      </article>
      <!-- The end of the piece: who wrote it, and the same text in the forms
           a reader might want to keep. -->
      <footer
        class="mt-16 flex flex-wrap items-center gap-x-4 gap-y-3 border-border-subtle border-t pt-8 text-fg-meta text-meta"
      >
        <Avatar name={author} size="md" />
        <span>Written by <span class="text-fg">{author}</span></span>
        <span class="flex gap-4 sm:ms-auto">
          <a href={`/blog/${post.id}.md`} class="transition-colors hover:text-fg">
            Read as Markdown
          </a>
          <a href="/rss.xml" class="transition-colors hover:text-fg">RSS</a>
        </span>
      </footer>
    </div>
    <div class="min-w-0 xl:col-start-3 xl:row-start-1">
      <ReadingRail headings={headings} bodyId={BODY_ID} />
    </div>
  </div>

  {
    neighbours.length > 0 && (
      <nav
        aria-label="More posts"
        class="mx-auto grid w-full max-w-[47rem] gap-4 px-6 sm:grid-cols-2"
      >
        {neighbours.map(({ post: other, label }, i) => (
          <Reveal
            delay={i * 0.08}
            class={!newer && i === 0 ? 'sm:col-start-2' : undefined}
          >
            <a
              href={`/blog/${other.id}`}
              class="group flex h-full flex-col gap-3 rounded-2xl border border-border-subtle bg-panel p-6 transition-colors hover:border-border"
            >
              <span class="font-mono text-fg-meta text-mono-sm uppercase tracking-wider">
                {label}
              </span>
              <span class="text-balance text-fg text-section transition-colors group-hover:text-fg-brand">
                {other.data.title}
              </span>
              <time
                datetime={isoDate(other.data.date)}
                class="mt-auto text-fg-meta text-meta"
              >
                {formatDate(other.data.date)}
              </time>
            </a>
          </Reveal>
        ))}
      </nav>
    )
  }
  <Closing />
</Page>

<script>
  // A copy button on every code block, as the docs theme gave them. The
  // button is added here rather than in the HTML: without JavaScript it
  // could not copy anything. It sits on a wrapper, not in the `pre`, which
  // scrolls sideways and would take the button with it.
  for (const pre of document.querySelectorAll<HTMLElement>('.prose pre')) {
    const block = document.createElement('div');
    block.className = 'code-block';
    pre.replaceWith(block);
    block.append(pre);
    const button = document.createElement('button');
    button.type = 'button';
    button.className = 'code-copy';
    button.textContent = 'Copy';
    button.addEventListener('click', () => {
      const code = pre.querySelector('code')?.innerText ?? '';
      navigator.clipboard?.writeText(code).then(() => {
        button.textContent = 'Copied';
        setTimeout(() => {
          button.textContent = 'Copy';
        }, 1600);
      }, () => {});
    });
    block.append(button);
  }
</script>
