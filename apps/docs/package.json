{
  "name": "docs",
  "version": "0.19.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "cp ../server/openapi.json public/openapi.json && astro dev --port 3001",
    "build": "cp ../server/openapi.json public/openapi.json && astro build && pagefind --site dist",
    "preview": "astro preview --port 3001",
    "check-types": "astro check",
    "lint": "biome check .",
    "format:check": "biome format .",
    "test": "node --test src/lib/*.test.ts"
  },
  "dependencies": {
    "@astrojs/markdown-remark": "7.3.10",
    "@astrojs/mdx": "8.1.6",
    "@astrojs/react": "7.1.9",
