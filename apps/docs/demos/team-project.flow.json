{
  "title": "Add someone to a project",
  "url": "http://localhost:8090/projects/3/settings/members",
  "viewport": { "width": 1440, "height": 900 },
  "steps": [
    { "action": "wait", "for": { "role": "button", "name": "Add Member" } },
    {
      "action": "click",
      "target": { "role": "button", "name": "Add Member" },
      "tooltip": "Give someone a role on this project alone"
    },
    {
      "action": "click",
      "target": { "role": "combobox", "name": "Select a user to add" },
      "hotspot": false
    },
    {
      "action": "click",
      "target": { "role": "option", "name": "priya@linden.example" },
      "hotspot": false
    },
    {
      "action": "click",
      "target": { "role": "combobox", "name": "Role for new member" },
      "tooltip": "You can only pick roles you hold yourself"
    },
    {
      "action": "click",
      "target": { "role": "option", "name": "Editor" },
      "hotspot": false
    },
    {
      "action": "click",
      "target": { "role": "button", "name": "Add", "exact": true },
      "tooltip": "Priya now sees Billing worker and can triage its issues"
    },
    { "action": "wait", "for": { "text": "priya@linden.example", "nth": 0 } },
    { "action": "wait", "ms": 800 }
  ]
}
