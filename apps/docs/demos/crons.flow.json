{
  "title": "Check a cron monitor",
  "url": "http://localhost:8090/projects/3/crons",
  "viewport": { "width": 1440, "height": 900 },
  "steps": [
    { "action": "wait", "for": { "role": "link", "name": "New monitor" } },
    { "action": "click", "target": { "role": "link", "name": "issue-invoices", "nth": 0 }, "tooltip": "Every job, its schedule and its runs. issue-invoices is failing" },
    { "action": "wait", "for": { "role": "heading", "name": "Check-ins" } },
    { "action": "scroll", "target": { "role": "heading", "name": "Check-ins" } },
    { "action": "scroll", "by": 350 },
    { "action": "click", "target": { "role": "button", "name": "Mute" }, "tooltip": "Each run with its status and duration. Down for maintenance? Mute it" },
    { "action": "wait", "for": { "role": "button", "name": "Unmute" } }
  ]
}
