{
  "title": "Create an API token",
  "url": "http://localhost:8090/settings/tokens",
  "viewport": { "width": 1440, "height": 900 },
  "steps": [
    { "action": "wait", "for": { "role": "button", "name": "New Token" } },
    {
      "action": "click",
      "target": { "role": "button", "name": "New Token" },
      "tooltip": "Your tokens, with what each is limited to and when it was last used"
    },
    {
      "action": "fill",
      "target": { "role": "textbox", "name": "Description (optional)" },
      "value": "CI deploy"
    },
    {
      "action": "click",
      "target": { "role": "combobox", "name": "Permissions" },
      "tooltip": "A job rarely needs all you can do. Give it only what it uses"
    },
    {
      "action": "click",
      "target": { "role": "option", "name": "Custom permissions" },
      "hotspot": false
    },
    { "action": "wait", "ms": 500 },
    {
      "action": "click",
      "target": { "role": "tab", "name": "Releases" },
      "hotspot": false
    },
    {
      "action": "click",
      "target": {
        "role": "checkbox",
        "name": "Source maps and debug files: Create"
      },
      "tooltip": "Enough for sentry-cli to upload source maps"
    },
    {
      "action": "click",
      "target": { "role": "button", "name": "Create Token" },
      "hotspot": false
    },
    { "action": "wait", "for": { "role": "heading", "name": "Token Created" } },
    {
      "action": "click",
      "target": { "role": "button", "name": "Copy the new token" },
      "tooltip": "Copy it now. Only a hash is stored, so nobody can show it again",
      "zoom": 1.8
    },
    {
      "action": "click",
      "target": { "role": "button", "name": "Done" },
      "hotspot": false
    },
    { "action": "wait", "for": { "text": "CI deploy" } },
    { "action": "wait", "ms": 800 }
  ]
}
