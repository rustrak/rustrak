# Server Configuration
HOST=0.0.0.0
PORT=8080
RUST_LOG=info
# Optional. IANA zone name (e.g. Asia/Shanghai) to convert log timestamps for
# display. Falls back to UTC if unset or unrecognized. Display only: it does not
# affect event/issue timestamps in storage or the API, which are always UTC.
# RUSTRAK_LOG_TIMEZONE=Asia/Shanghai

# Database (optional)
# A plain `cargo run` builds with SQLite. Unset, the database is
# sqlite:///data/rustrak.db, the path the Docker image uses; for local
# development keep it next to the checkout instead.
DATABASE_URL=sqlite://./rustrak.db
# For PostgreSQL, start it with `docker compose -f docker-compose.dev.yml up -d postgres`,
# use this URL instead, and run with `--no-default-features --features postgres`.
# DATABASE_URL=postgres://rustrak:rustrak@localhost:5432/rustrak

# Pool Configuration (optional, these are the defaults)
# DATABASE_MAX_CONNECTIONS=10
# DATABASE_MIN_CONNECTIONS=1
# DATABASE_ACQUIRE_TIMEOUT_SECS=5
# DATABASE_IDLE_TIMEOUT_SECS=600
# DATABASE_MAX_LIFETIME_SECS=1800

# Source maps (optional)
# Defaults to /data/sourcemaps, inside the Docker image's /data volume. Outside
# Docker, point it at a writable directory.
SOURCEMAP_STORAGE_PATH=./data/sourcemaps

# Production Security
# SSL_PROXY: Set to "true" when behind a reverse proxy that terminates SSL (nginx, Cloudflare, etc.)
# When true: secure cookies are enabled, SESSION_SECRET_KEY is required
# SSL_PROXY=true

# Session Security
# Generate with: openssl rand -hex 32
# Required when SSL_PROXY=true, optional otherwise (random key used if not set)
# Must be at least 64 characters; the server refuses to start below that
# SESSION_SECRET_KEY=generate-your-own-with-openssl-rand-hex-32

# Bootstrap Superuser (optional, only on first startup)
# Format: email:password
# Only creates user if database is empty
# CREATE_SUPERUSER=admin@example.com:changeme123

# OpenID Connect SSO (optional; compatible with Pocket ID and other OIDC providers)
# Create an OIDC client in your provider with the exact redirect URL below.
# OIDC_ISSUER_URL=https://id.example.com
# OIDC_CLIENT_ID=rustrak
# OIDC_CLIENT_SECRET=replace-with-client-secret
# OIDC_REDIRECT_URL=https://rustrak.example.com/auth/sso/callback
# OIDC_PROVIDER_NAME=Pocket ID
# OIDC_SCOPES=openid email profile
# OIDC_AUTO_PROVISION=true
# OIDC_REQUIRE_EMAIL_VERIFIED=true
# Optional comma-separated allowlist, for example: example.com,subsidiary.example
# OIDC_ALLOWED_DOMAINS=

# Public URL (optional)
# The address people and SDKs reach. Used to build DSN strings and the issue
# links in alert notifications.
# Must include scheme (http:// or https://). Trailing slash is stripped automatically.
# If unset, falls back to http://{HOST}:{PORT}.
# PUBLIC_URL=https://rustrak.example.com

# Dashboard (optional)
# The server serves the dashboard at / on the same port. `off` keeps it
# API-only, for a dashboard served from another host.
# RUSTRAK_DASHBOARD=on

# Where the compiled dashboard lives, relative to the working directory or
# absolute. Mounted only when the directory actually holds an index.html, so a
# build without one serves the API only.
# Defaults to ./static, which is where scripts/bundle-dashboard.sh puts a build.
# RUSTRAK_DASHBOARD_DIR=./static

# Base URL for the issue links in alert notifications. Defaults to PUBLIC_URL;
# set it only when the dashboard is served from another host.
# DASHBOARD_URL=https://dashboard.example.com

# Anonymous telemetry (optional)
# On by default. Either of these turns it off.
# RUSTRAK_TELEMETRY=off
# DO_NOT_TRACK=1
