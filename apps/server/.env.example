# Server Configuration
HOST=0.0.0.0
PORT=8080
RUST_LOG=info
# Optional. IANA zone name (e.g. Asia/Shanghai) to convert log timestamps for
# display. Falls back to UTC if unset or unrecognized. Display-only — does not
# affect event/issue timestamps in storage or the API, which are always UTC.
# RUSTRAK_LOG_TIMEZONE=Asia/Shanghai

# Database Configuration (required)
DATABASE_URL=postgres://rustrak:rustrak@localhost:5432/rustrak

# Pool Configuration (optional - these are the defaults)
# DATABASE_MAX_CONNECTIONS=10
# DATABASE_MIN_CONNECTIONS=1
# DATABASE_ACQUIRE_TIMEOUT_SECS=5
# DATABASE_IDLE_TIMEOUT_SECS=600
# DATABASE_MAX_LIFETIME_SECS=1800

# Production Security
# SSL_PROXY: Set to "true" when behind a reverse proxy that terminates SSL (nginx, Cloudflare, etc.)
# When true: secure cookies are enabled, SESSION_SECRET_KEY is required
# SSL_PROXY=true

# Session Security
# Generate with: openssl rand -hex 32
# Required when SSL_PROXY=true, optional otherwise (random key used if not set)
# Must be at least 64 characters; the server refuses to start below that
# SESSION_SECRET_KEY=generate-your-own-with-openssl-rand-hex-32

# Bootstrap Superuser (optional - only on first startup)
# Format: email:password
# Only creates user if database is empty
# CREATE_SUPERUSER=admin@example.com:changeme123

# OpenID Connect SSO (optional; compatible with Pocket ID and other OIDC providers)
# Create an OIDC client in your provider with the exact redirect URL below.
# OIDC_ISSUER_URL=https://id.example.com
# OIDC_CLIENT_ID=rustrak
# OIDC_CLIENT_SECRET=replace-with-client-secret
# OIDC_REDIRECT_URL=https://rustrak.example.com/auth/sso/callback
# OIDC_PROVIDER_NAME=Pocket ID
# OIDC_SCOPES=openid email profile
# OIDC_AUTO_PROVISION=true
# OIDC_REQUIRE_EMAIL_VERIFIED=true
# Optional comma-separated allowlist, for example: example.com,subsidiary.example
# OIDC_ALLOWED_DOMAINS=

# Public URL (optional)
# The full public URL where the server is accessible. Used to build DSN strings shown to users.
# Must include scheme (http:// or https://). Trailing slash is stripped automatically.
# If unset, falls back to http://{HOST}:{PORT} (fine for local development).
# Example: PUBLIC_URL=https://api.yourdomain.com
# PUBLIC_URL=https://api.yourdomain.com
