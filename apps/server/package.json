{
  "name": "@rustrak/server",
  "version": "0.25.0",
  "private": true,
  "scripts": {
    "build": "bash ../../scripts/bundle-dashboard.sh && cargo build --release",
    "build:dev": "bash ../../scripts/bundle-dashboard.sh && cargo build",
    "dev": "cargo watch -x run",
    "start": "cargo run --release",
    "test": "cargo test --features openapi --locked",
    "test:postgres:e2e": "cargo test --no-default-features --features postgres --locked --test e2e_tests",
    "lint": "cargo clippy --all-targets --features openapi --locked -- -D warnings",
    "lint:postgres": "cargo clippy --all-targets --no-default-features --features postgres,openapi --locked -- -D warnings",
    "openapi": "cargo run --bin gen_openapi --features openapi --locked",
    "openapi:check": "pnpm run openapi && git diff --exit-code -- openapi.json",
    "clean": "cargo clean && rm -rf static",
    "format": "cargo fmt",
    "format:check": "cargo fmt -- --check"
  }
}
