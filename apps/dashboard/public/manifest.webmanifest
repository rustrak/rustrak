{
  "id": "/",
  "name": "Rustrak",
  "short_name": "Rustrak",
  "description": "Self-hosted error tracking compatible with Sentry SDKs",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "background_color": "#161616",
  "theme_color": "#222222",
  "categories": ["developer", "productivity", "utilities"],
  "icons": [
    {
      "src": "/icons/pwa-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/icons/pwa-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/icons/maskable-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "maskable"
    },
    {
      "src": "/icons/maskable-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ],
  "screenshots": [
    {
      "src": "/screenshots/narrow.png",
      "sizes": "786x1318",
      "type": "image/png",
      "form_factor": "narrow",
      "label": "Issues on a phone"
    },
    {
      "src": "/screenshots/wide.png",
      "sizes": "1280x800",
      "type": "image/png",
      "form_factor": "wide",
      "label": "Issues on a desktop"
    }
  ],
  "shortcuts": [
    {
      "name": "Issues",
      "url": "/issues",
      "icons": [{ "src": "/icons/pwa-192.png", "sizes": "192x192" }]
    },
    {
      "name": "Projects",
      "url": "/projects",
      "icons": [{ "src": "/icons/pwa-192.png", "sizes": "192x192" }]
    }
  ],
  "launch_handler": { "client_mode": ["navigate-existing", "auto"] }
}
