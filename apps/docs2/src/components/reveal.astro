---
/**
 * A block that sharpens up out of a blur as it scrolls in. See `site.css`.
 * The other props tune where it comes from, for the moves that are not the
 * default one. `layer` keeps a large block on its own layer (see `site.css`).
 */
interface Props {
  as?: 'div' | 'li' | 'span';
  layer?: boolean;
  class?: string;
  delay?: number;
  y?: number;
  x?: number;
  scale?: number;
  blur?: number;
  duration?: number;
  style?: string;
}
const {
  as: Tag = 'div',
  layer = false,
  class: className,
  delay = 0,
  y = 24,
  x,
  scale,
  blur,
  duration,
  style,
} = Astro.props;
const vars = [
  `--delay:${delay}s`,
  `--y:${y}px`,
  x !== undefined && `--x:${x}px`,
  scale !== undefined && `--scale:${scale}`,
  blur !== undefined && `--blur:${blur}px`,
  duration !== undefined && `--duration:${duration}s`,
  style,
]
  .filter(Boolean)
  .join(';');
---

<Tag
  data-reveal
  data-layer={layer ? '' : undefined}
  class={className}
  style={vars}
>
  <slot />
</Tag>
