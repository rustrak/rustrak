---
import { CONTAINER } from '../site';
import Reveal from './reveal.astro';
import Words from './words.astro';

/**
 * The opening of the blog, the changelog and the roadmap: the landing's
 * section head at page size. Eyebrow, a title rising word by word, and an
 * optional lead and line of meta under it (the `meta` slot).
 */
interface Props {
  eyebrow: string;
  title: string;
  lead?: string;
}
const { eyebrow, title, lead } = Astro.props;
---

<header class:list={[CONTAINER, 'flex flex-col gap-5 pt-36 sm:pt-44']}>
  <Reveal y={12}>
    <p class="font-mono text-fg-brand text-mono uppercase tracking-wider">
      {eyebrow}
    </p>
  </Reveal>
  <Words
    as="h1"
    text={title}
    delay={0.1}
    class="max-w-[16ch] text-balance text-display text-fg"
  />
  {
    lead && (
      <Reveal delay={0.35}>
        <p class="max-w-xl text-pretty text-fg-subtle text-lead">{lead}</p>
      </Reveal>
    )
  }
  {
    Astro.slots.has('meta') && (
      <Reveal
        delay={0.45}
        class="flex flex-wrap items-center gap-x-3 gap-y-1 text-fg-meta text-meta"
      >
        <slot name="meta" />
      </Reveal>
    )
  }
</header>
