---
import { Image } from 'astro:assets';
import { StarIcon } from '@rustrak/ui';
import backdrop from '../assets/lime-swirl.jpg';
import { CONTAINER, GITHUB, START } from '../site';
import { LinkButton } from './link-button';
import { AppFrame, OverviewScreen } from './product';
import Reveal from './reveal.astro';
import Scaled from './scaled.astro';
import Words from './words.astro';
---

<!--
  The claim, then the product on a landscape. The image is a backdrop, not a
  device: an abstract in the brand's lime, blurred like every other product
  shot on the page. On it, the project overview floats at desktop size, laid
  out at full width and scaled down, so it reads as a screenshot.
-->
<section class="pt-36 sm:pt-44">
  <div class:list={[CONTAINER, 'flex flex-col items-center text-center']}>
    <Words
      as="h1"
      text="Error tracking you actually own."
      delay={0.15}
      class="max-w-[14ch] text-balance text-display text-fg"
    />
    <Reveal delay={0.55} layer>
      <p class="mt-6 max-w-xl text-pretty text-lead text-fg-subtle">
        Point the Sentry SDKs you already use at one binary on your own server.
        Issues, traces, logs and alerts, with your data never leaving it.
      </p>
    </Reveal>
    <Reveal delay={0.7} layer class="mt-10 flex items-center gap-3">
      <LinkButton href={START} variant="primary" size="lg">Get started</LinkButton>
      <LinkButton href={GITHUB} variant="secondary" size="lg" icon={StarIcon}>
        Star on GitHub
      </LinkButton>
    </Reveal>
  </div>

  <!-- The product tips up out of the page, Linear-style, once the claim has landed. -->
  <div class="mx-auto mt-20 w-full max-w-7xl px-4 [perspective:2000px] sm:px-6">
    <div
      inert
      class="tip relative aspect-[16/10] overflow-hidden rounded-3xl border border-border-subtle"
    >
      <!-- Blurred to nothing, so a small file is all it needs. -->
      <Image
        src={backdrop}
        alt=""
        widths={[480, 960]}
        sizes="(min-width: 80rem) 80rem, 100vw"
        loading="eager"
        fetchpriority="high"
        class="absolute inset-0 size-full scale-110 object-cover blur-2xl saturate-[0.85]"
      />
      <div class="absolute inset-0 bg-canvas/20"></div>

      <div
        class="lift absolute top-[7%] right-[5%] bottom-0 left-[5%] overflow-hidden rounded-t-2xl border-white/15 border-x border-t shadow-dialog"
      >
        <Scaled width={1440} class="size-full">
          <AppFrame section="overview">
            <OverviewScreen />
          </AppFrame>
        </Scaled>
      </div>
    </div>
  </div>
</section>

<style>
  /* Layers kept after the move, for the reason in `home.css`. */
  .tip {
    will-change: opacity, transform;
    transform-origin: 50% 0%;
    animation: tip 1.6s var(--ease-landing) 0.85s both;
  }
  .lift {
    will-change: transform;
    animation: lift 1.8s var(--ease-landing) 1.05s both;
  }
  @keyframes tip {
    from {
      opacity: 0;
      transform: translateY(80px) rotateX(18deg) scale(0.94);
    }
  }
  @keyframes lift {
    from {
      transform: translateY(60px);
    }
  }
  @media (prefers-reduced-motion: reduce) {
    @keyframes tip {
      from {
        opacity: 0;
      }
    }
    .lift {
      animation: none;
    }
  }
</style>
