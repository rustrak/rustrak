---
import { render } from 'astro:content';
import { ArrowRightIcon } from '@rustrak/ui';
import { formatDate, getPosts, isoDate, readingTime } from '../../blog';
import Backdrop from '../../components/backdrop.astro';
import { LinkButton } from '../../components/link-button';
import PageIntro from '../../components/page-intro.astro';
import Reveal from '../../components/reveal.astro';
import Page from '../../layouts/page.astro';
import { CONTAINER } from '../../site';

const [latest, ...earlier] = await getPosts();

/**
 * The latest post's sections. A blog of long technical write-ups is
 * badly served by a two-line standfirst: what a reader is deciding is whether
 * the piece covers what they came for, and the section titles answer that
 * better than a summary of them. There are no cover images and never will
 * be, so the structure of the writing is the illustration.
 */
const outline = latest
  ? (await render(latest)).headings.filter((h) => h.depth === 2)
  : [];
---

<!--
  The blog index: the section head, the latest post set on the landing's
  photograph with its contents beside it, then the rest as one row each.
-->
<Page
  title="Blog — Rustrak"
  description="Updates, releases, and engineering notes from the Rustrak project."
>
  <PageIntro
    eyebrow="Blog"
    title="Notes from building Rustrak."
    lead="Release announcements, and the longer write-ups of how a piece of Rustrak works once it is finished."
  >
    <Fragment slot="meta">
      <span>{earlier.length + (latest ? 1 : 0)} posts</span>
      <span aria-hidden="true">·</span>
      <a href="/rss.xml" class="transition-colors hover:text-fg">RSS feed</a>
    </Fragment>
  </PageIntro>

  {
    latest ? (
      <div class:list={[CONTAINER, 'pt-16']}>
        <Backdrop dim delay={0.2}>
          <article class="grid gap-10 p-8 sm:p-12 lg:grid-cols-[minmax(0,3fr)_minmax(0,2fr)] lg:gap-16">
            <div class="flex flex-col gap-5">
              <p class="flex flex-wrap items-center gap-x-3 font-mono text-mono uppercase tracking-wider">
                <span class="text-fg-brand">Latest</span>
                <time datetime={isoDate(latest.data.date)} class="text-fg-secondary">
                  {formatDate(latest.data.date)}
                </time>
              </p>
              <h2 class="text-balance text-fg text-headline">
                <a href={`/blog/${latest.id}`} class="transition-colors hover:text-fg-brand">
                  {latest.data.title}
                </a>
              </h2>
              <p class="max-w-[52ch] text-pretty text-fg-secondary text-lead">
                {latest.data.description}
              </p>
              <div class="mt-3 flex flex-wrap items-center gap-x-5 gap-y-3">
                <LinkButton href={`/blog/${latest.id}`} variant="primary" size="lg">
                  Read the post
                </LinkButton>
                <span class="text-fg-secondary text-meta">
                  {latest.data.author} · {readingTime(latest.body)}
                </span>
              </div>
            </div>
            {outline.length > 0 && (
              <nav aria-label={`In “${latest.data.title}”`} class="flex flex-col gap-4">
                <p class="font-mono text-fg-secondary text-mono uppercase tracking-wider">
                  In this post
                </p>
                <ol class="flex flex-col">
                  {outline.map((heading) => (
                    <li>
                      <a
                        href={`/blog/${latest.id}#${heading.slug}`}
                        class="group flex items-center justify-between gap-4 border-fg/12 border-t py-3 text-fg-secondary text-value transition-colors hover:text-fg"
                      >
                        {heading.text}
                        <ArrowRightIcon
                          aria-hidden
                          className="size-4 shrink-0 -translate-x-1 opacity-0 transition-[opacity,translate] duration-moderate ease-standard group-hover:translate-x-0 group-hover:opacity-100"
                        />
                      </a>
                    </li>
                  ))}
                </ol>
              </nav>
            )}
          </article>
        </Backdrop>
      </div>
    ) : (
      <p class:list={[CONTAINER, 'pt-16 text-fg-subtle text-value']}>
        No posts yet. Check back soon.
      </p>
    )
  }

  {
    earlier.length > 0 && (
      <section class:list={[CONTAINER, 'pt-24 pb-28']}>
        <Reveal y={12}>
          <h2 class="font-mono text-fg-meta text-mono uppercase tracking-wider">
            Earlier
          </h2>
        </Reveal>
        <ol class="mt-6 border-border-subtle border-b">
          {earlier.map((post, index) => (
            // One post as one row: the date in a narrow column, the title,
            // the summary and the subjects beside it. Rows sit on hairlines,
            // nothing else frames them.
            <Reveal as="li" delay={Math.min(index, 4) * 0.06}>
              <a
                href={`/blog/${post.id}`}
                class="group grid gap-3 border-border-subtle border-t py-10 sm:grid-cols-[11rem_minmax(0,1fr)] sm:gap-10"
              >
                <div class="flex flex-col gap-1 text-fg-meta text-meta">
                  <time datetime={isoDate(post.data.date)}>
                    {formatDate(post.data.date)}
                  </time>
                  <span>{readingTime(post.body)}</span>
                </div>
                <div class="flex flex-col gap-3">
                  <h3 class="flex items-start gap-3 text-balance text-fg text-page-title transition-colors group-hover:text-fg-brand">
                    {post.data.title}
                    <ArrowRightIcon
                      aria-hidden
                      className="mt-1 size-5 shrink-0 -translate-x-1 opacity-0 transition-[opacity,translate] duration-moderate ease-standard group-hover:translate-x-0 group-hover:opacity-100"
                    />
                  </h3>
                  <p class="max-w-[60ch] text-pretty text-fg-subtle text-value">
                    {post.data.description}
                  </p>
                  {post.data.tags.length > 0 && (
                    <p class="font-mono text-fg-meta text-mono-sm">
                      {post.data.tags.join(' · ')}
                    </p>
                  )}
                </div>
              </a>
            </Reveal>
          ))}
        </ol>
      </section>
    )
  }
</Page>
